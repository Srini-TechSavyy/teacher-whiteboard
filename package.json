{
  "name": "teacher-whiteboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.dev -e .env.local -- next dev",
    "build": "next build",
    "start": "next start",
    "dev:vinext": "dotenv -e .env.dev -e .env.local -- vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "deploy:cf": "pnpm run deploy:vinext",
    "deploy": "pnpm run build:vinext && bash scripts/deploy-wrangler.sh",
    "preview": "pnpm run build:vinext && pnpm run start:vinext",
    "db:schema": "dotenv -e .env.dev -e .env.local -- bash scripts/apply-schema.sh",
    "cf-typegen": "cf workers types"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "vinext": "latest",
    "react-server-dom-webpack": "latest",
    "@vinext/cloudflare": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vite": "8.3.0",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "@cloudflare/vite-plugin": "beta",
    "cf": "latest",
    "dotenv-cli": "^8.0.0"
  },
  "type": "module"
}
